---
/**
 * articles/index.astro — All articles archive
 */
import BaseLayout  from '@layouts/BaseLayout.astro';
import ArticleCard from '@components/ArticleCard.astro';
import NewsletterSection from '@components/NewsletterSection.astro';
import { buildCanonical } from '@utils/seo';
import { getCollection } from 'astro:content';

const articles = (await getCollection('articles', (e) => !e.data.draft))
  .sort((a, b) => b.data.publishDate.getTime() - a.data.publishDate.getTime());

const canonical = buildCanonical('/articles/');
---

<BaseLayout
  title="Articles"
  description="Expert guides, honest reviews, and lifestyle tips from Lucky Living."
  canonical={canonical}
>

  <section class="relative py-16 lg:py-24 bg-slate-900 text-white">
    <div class="container">
      <h1 class="font-serif text-4xl lg:text-5xl font-bold mb-4">
        Articles
      </h1>
      <p class="text-lg text-white/70 max-w-2xl">
        In-depth guides, trends, and smart living ideas — updated regularly.
      </p>
    </div>
  </section>

  <section class="section bg-white">
    <div class="container">
      {articles.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {articles.map((article) => (
            <ArticleCard entry={article} />
          ))}
        </div>
      ) : (
        <div class="text-center py-20">
          <p class="text-slate-500">No articles published yet. Check back soon.</p>
          <a href="/" class="btn-primary mt-6 inline-flex">Back to Home</a>
        </div>
      )}
    </div>
  </section>

  <NewsletterSection />

</BaseLayout>
